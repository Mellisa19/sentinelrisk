# SentinelRisk Production Environment Configuration
# Copy this file to .env and fill in your actual values

# Application
APP_NAME=SentinelRisk
APP_VERSION=2.0.0
DEBUG=false

# Security (Generate these with: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-here-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
API_KEY_HEADER=X-API-KEY

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/sentinelrisk
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (Optional - for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=

# Model Paths
MODEL_PATH=models/xgboost_fraud.pkl
PREPROCESSOR_PATH=models/preprocessor.pkl

# CORS (Comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
